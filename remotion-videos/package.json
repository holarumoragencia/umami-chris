{
  "name": "remotion-videos",
  "version": "1.0.0",
  "private": true,
  "description": "Videos animados para LinkedIn hechos con Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Absentismo-4x5 out/absentismo-4x5.mp4",
    "render:vertical": "remotion render Absentismo-9x16 out/absentismo-9x16.mp4",
    "render:all": "npm run render && npm run render:vertical",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "^4.0.532",
    "@remotion/fonts": "^4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
